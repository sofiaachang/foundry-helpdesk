# Names only. Real values live in the Railway dashboard (or a local .env that is gitignored).
# Never commit a filled-in copy of this file.

# Foundry (Developer Console client-facing app, user permissions, public client with PKCE; see plan KTD3)
FOUNDRY_STACK_URL=https://zap.usw-18.palantirfoundry.com
FOUNDRY_CLIENT_ID=
# Public clients have no secret. The service obtains a delegated user token via /auth/start (one-time login)
# and refreshes it unattended. FOUNDRY_REDIRECT_URL must match the app's registered redirect URL.
FOUNDRY_REDIRECT_URL=http://localhost:3000/auth/callback
FOUNDRY_ONTOLOGY_RID=

# Which adapter to run: "osdk" (real Foundry, needs the generated SDK installed) or "fake" (in-memory seed, local only)
FOUNDRY_ADAPTER=fake

# Shared secret the ElevenLabs tools send in X-Helpdesk-Secret. Comma-separated "current,previous" during rotation.
HELPDESK_SHARED_SECRET=

# ElevenLabs post-call webhook signing secret
ELEVENLABS_WEBHOOK_SECRET=

# Pepper for the HMAC-SHA256 PIN hash. The seed generator must use the same value.
PIN_PEPPER=

# Caller-id lockout (plan KTD7 defaults)
LOCKOUT_MAX_FAILURES=6
LOCKOUT_WINDOW_MS=900000

# Artificial delay for AE8 rehearsals, milliseconds. 0 in production.
SLOW_TOOLS_MS=0

# Session expiry, milliseconds. Matches the agent's max_duration_seconds (600 s).
SESSION_TTL_MS=600000

PORT=3000
LOG_LEVEL=info
