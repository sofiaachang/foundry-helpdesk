{
  "type": "webhook",
  "name": "list_my_open_issues",
  "description": "List the verified caller's open issues: a count and up to three items. Requires a verified caller. Takes no parameters.",
  "response_timeout_secs": 10,
  "pre_tool_speech": "auto",
  "execution_mode": "immediate",
  "interruption_mode": "allow",
  "tool_error_handling_mode": "hide",
  "api_schema": {
    "url": "https://REPLACE-AT-G6.example.invalid/tools/list_my_open_issues",
    "method": "POST",
    "content_type": "application/json",
    "request_headers": {
      "X-Helpdesk-Secret": {
        "secret_id": "wsec_REPLACE_WITH_ID_OF_helpdesk_shared_secret"
      }
    },
    "request_body_schema": {
      "type": "object",
      "description": "Tool request body. conversation_id and caller_id are filled by the system, never by the model.",
      "properties": {
        "conversation_id": {
          "type": "string",
          "dynamic_variable": "system__conversation_id"
        },
        "caller_id": {
          "type": "string",
          "dynamic_variable": "system__caller_id"
        }
      },
      "required": [
        "conversation_id"
      ]
    }
  }
}
