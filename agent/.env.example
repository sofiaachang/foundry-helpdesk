# Copy to .env (git-ignored). The CLI loads .env from the working directory; render.ts reads the same variables.

# ElevenLabs API key (or use `elevenlabs auth login` instead)
ELEVENLABS_API_KEY=your_api_key_here

# Railway service URL, known at G6. No trailing slash.
HELPDESK_BASE_URL=https://REPLACE-AT-G6.example.invalid

# Id (wsec_...) of the workspace secret named helpdesk_shared_secret, created at G4.
HELPDESK_SECRET_ID=wsec_REPLACE_WITH_ID_OF_helpdesk_shared_secret

# Caller id used by the browser-test agent and the simulations. Must match the demo caller in the U3 seed.
HELPDESK_TEST_CALLER_ID=+15550100000

# Transcript retention in days, decided at G4b (KTD14 recommends 14).
HELPDESK_RETENTION_DAYS=14

# Optional overrides
# HELPDESK_LLM=gemini-2.5-flash
# HELPDESK_VOICE_ID=cjVigY5qzO86Huf0OWal
